MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/inboxpilot
INTERNAL_API_KEY=change-me-shared-with-nextjs-proxy
COMPOSIO_API_KEY=change-me
# optional: only when using your own Google OAuth app (default: Composio managed auth)
COMPOSIO_AUTH_CONFIG_ID=change-me
# optional: auto-fetched at startup when BACKEND_PUBLIC_URL is set; or copy from Composio dashboard
COMPOSIO_WEBHOOK_SECRET=change-me
# e.g. https://inboxpilot-api.fly.dev — enables automatic webhook registration
BACKEND_PUBLIC_URL=change-me
ANTHROPIC_API_KEY=change-me
OPENAI_API_KEY=change-me
STRIPE_SECRET_KEY=change-me
STRIPE_WEBHOOK_SECRET=change-me
STRIPE_PRICE_ID=change-me
FRONTEND_URL=http://localhost:3000
