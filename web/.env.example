# App URL + NextAuth secret (generate: openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme

# Magic-link email delivery (Resend)
RESEND_API_KEY=re_xxx
EMAIL_FROM=InboxPilot <login@yourdomain.com>

# NextAuth MongoDB adapter
# The database name is pinned to "inboxpilot" in code (auth.ts /
# lib/mongodb.ts), matching the FastAPI backend (api/app/db.py) — any path
# segment on this URI is ignored, so it's fine to omit it here.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/inboxpilot

# FastAPI backend
BACKEND_URL=http://localhost:8080
INTERNAL_API_KEY=changeme-shared-with-backend
